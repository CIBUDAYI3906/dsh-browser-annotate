{
  "name": "dsh-browser-annotate",
  "version": "0.1.1",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.4.0",
    "node": ">=20"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "check": "node --check index.js && node --check client.js && node scripts/preflight.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "annotation",
    "annotate",
    "element-picker",
    "html-preview"
  ],
  "license": "MIT",
  "description": "圈选 DSH 右侧浏览器里的页面元素，把定位信息和修改意见发给 AI（Desktop）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CIBUDAYI3906/dsh-browser-annotate.git"
  },
  "homepage": "https://github.com/CIBUDAYI3906/dsh-browser-annotate#readme",
  "bugs": {
    "url": "https://github.com/CIBUDAYI3906/dsh-browser-annotate/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    },
    "manifestVersion": 1
  }
}
